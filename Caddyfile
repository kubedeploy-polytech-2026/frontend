{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /health {
		respond "ok" 200
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8080}
	}

	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
